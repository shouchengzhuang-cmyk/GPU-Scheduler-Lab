{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shouchengzhuang-cmyk/GPU-Scheduler-Lab/contracts/mini-ai-cloud-v2.schema.json",
  "title": "Mini AI Cloud to GPU Scheduler Lab typed accelerator export v2",
  "type": "object",
  "required": ["contract_version", "workers", "tasks"],
  "properties": {
    "contract_version": {"const": "mini-ai-cloud.gpu-scheduler-lab/v2"},
    "exported_at": {"type": "string", "format": "date-time"},
    "producer": {"type": "string", "minLength": 1},
    "workers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "gpu_devices"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "schedulable": {"type": "boolean", "default": true},
          "labels": {
            "type": "object",
            "additionalProperties": {"type": "string"}
          },
          "gpu_devices": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "vendor",
                "kind",
                "model",
                "memory_total_mb",
                "runtime_profiles",
                "capabilities"
              ],
              "properties": {
                "device_uuid": {"type": "string", "minLength": 1},
                "vendor": {"enum": ["nvidia", "huawei-ascend"]},
                "kind": {"enum": ["gpu", "npu"]},
                "model": {"type": "string", "minLength": 1},
                "memory_total_mb": {"type": "integer", "minimum": 1},
                "health": {"type": "string", "minLength": 1, "default": "healthy"},
                "runtime_profiles": {
                  "type": "array",
                  "items": {"type": "string", "minLength": 1},
                  "uniqueItems": true
                },
                "capabilities": {
                  "type": "array",
                  "items": {"type": "string", "minLength": 1},
                  "uniqueItems": true
                }
              },
              "oneOf": [
                {
                  "properties": {
                    "vendor": {"const": "nvidia"},
                    "kind": {"const": "gpu"}
                  },
                  "required": ["vendor", "kind"]
                },
                {
                  "properties": {
                    "vendor": {"const": "huawei-ascend"},
                    "kind": {"const": "npu"}
                  },
                  "required": ["vendor", "kind"]
                }
              ],
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "gpu_count",
          "allowed_vendors",
          "allowed_kinds",
          "allowed_models",
          "required_capabilities",
          "runtime_profile",
          "selection_policy"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "project_id": {"type": "string", "minLength": 1},
          "arrival_time": {
            "oneOf": [
              {"type": "number"},
              {"type": "string", "format": "date-time"}
            ]
          },
          "queued_at": {
            "oneOf": [
              {"type": "number"},
              {"type": "string", "format": "date-time"}
            ]
          },
          "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
          "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
          "gpu_count": {"type": "integer", "minimum": 0},
          "gpu_memory_mb": {"type": "integer", "minimum": 1},
          "priority": {"type": "integer", "minimum": 0, "maximum": 100},
          "workload_type": {"type": "string", "minLength": 1},
          "sla_deadline": {
            "oneOf": [
              {"type": "number"},
              {"type": "string", "format": "date-time"}
            ]
          },
          "allowed_vendors": {
            "type": "array",
            "items": {"enum": ["nvidia", "huawei-ascend"]},
            "uniqueItems": true
          },
          "allowed_kinds": {
            "type": "array",
            "items": {"enum": ["gpu", "npu"]},
            "uniqueItems": true
          },
          "allowed_models": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "required_capabilities": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "runtime_profile": {"type": ["string", "null"], "minLength": 1},
          "selection_policy": {"const": "any"},
          "labels": {
            "type": "object",
            "additionalProperties": {"type": "string"}
          }
        },
        "allOf": [
          {
            "if": {"properties": {"gpu_count": {"minimum": 1}}},
            "then": {"required": ["gpu_memory_mb"]}
          }
        ],
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
