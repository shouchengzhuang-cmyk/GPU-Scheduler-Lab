{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shouchengzhuang-cmyk/GPU-Scheduler-Lab/contracts/result-handoff-v1.schema.json",
  "title": "GPU Scheduler Lab simulated result handoff v1",
  "type": "object",
  "required": ["contract_version", "evidence_kind", "limitations", "results"],
  "properties": {
    "contract_version": {"const": "gpu-scheduler-lab.result/v1"},
    "evidence_kind": {"const": "SIMULATED"},
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scheduler", "elapsed_seconds", "metrics", "jobs"],
        "properties": {
          "scheduler": {"type": "string", "minLength": 1},
          "elapsed_seconds": {"type": "number", "minimum": 0},
          "metrics": {"type": "object"},
          "jobs": {"type": "array", "items": {"type": "object"}},
          "trace": {"type": "array", "items": {"type": "object"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
